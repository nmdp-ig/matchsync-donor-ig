  <url value="http://fhir.nmdp.org/ig/donor-patient/CapabilityStatement/nmdp-donor-api"/>
  <version value="0.1.0"/>
  <name value="NMDPDonorAPICapabilityStatement"/>
  <title value="NMDP Donor API Capability Statement"/>
  <status value="draft"/>
  <experimental value="true"/>
  <date value="2026-07-23"/>
  <publisher value="National Marrow Donor Program (NMDP)"/>
  <contact>
    <name value="National Marrow Donor Program (NMDP)"/>
    <telecom>
      <system value="url"/>
      <value value="https://www.nmdp.org"/>
    </telecom>
    <telecom>
      <system value="email"/>
      <value value="fhir@nmdp.org"/>
    </telecom>
  </contact>
  <description value="This CapabilityStatement describes the expected capabilities of a server implementing the NMDP Donor API FHIR interface. The server provides read and search access to donor demographics, HLA typing results, and order information."/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="US"/>
      <display value="United States of America"/>
    </coding>
  </jurisdiction>
  <kind value="requirements"/>
  <fhirVersion value="4.0.1"/>
  <format value="json"/>
  <format value="xml"/>
  <implementationGuide value="http://fhir.nmdp.org/ig/donor-patient/ImplementationGuide/nmdp.fhir.donor-patient"/>
  <rest>
    <mode value="server"/>
    <documentation value="The NMDP Donor API server provides RESTful access to donor information for authorized transplant centers."/>
    <resource>
      <type value="Patient"/>
      <profile value="http://fhir.nmdp.org/ig/donor-patient/StructureDefinition/nmdp-donor-patient"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <name value="identifier"/>
        <type value="token"/>
        <documentation value="Search by NMDP Donor ID or GRID"/>
      </searchParam>
      <searchParam>
        <name value="_id"/>
        <type value="token"/>
      </searchParam>
    </resource>
    <resource>
      <type value="Observation"/>
      <profile value="http://fhir.nmdp.org/ig/donor-patient/StructureDefinition/nmdp-hla-genotype"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <name value="subject"/>
        <type value="reference"/>
        <documentation value="Search HLA observations by donor Patient reference"/>
      </searchParam>
      <searchParam>
        <name value="code"/>
        <type value="token"/>
      </searchParam>
    </resource>
    <resource>
      <type value="ServiceRequest"/>
      <profile value="http://fhir.nmdp.org/ig/donor-patient/StructureDefinition/nmdp-donor-order"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <name value="subject"/>
        <type value="reference"/>
        <documentation value="Search orders by donor Patient reference"/>
      </searchParam>
      <searchParam>
        <name value="identifier"/>
        <type value="token"/>
        <documentation value="Search by NMDP Order ID"/>
      </searchParam>
    </resource>
    <resource>
      <type value="Organization"/>
      <profile value="http://fhir.nmdp.org/ig/donor-patient/StructureDefinition/nmdp-organization"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <name value="identifier"/>
        <type value="token"/>
        <documentation value="Search by NMDP Center ID"/>
      </searchParam>
      <searchParam>
        <name value="name"/>
        <type value="string"/>
      </searchParam>
    </resource>
  </rest>
</CapabilityStatement>