  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem nmdp-donor-status</b></p><a name=\"nmdp-donor-status\"> </a><a name=\"hcnmdp-donor-status\"> </a><p>This case-sensitive code system <code>http://terminology.nmdp.org/codesystem/donor-status</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">available<a name=\"nmdp-donor-status-available\"> </a></td><td>Available</td><td>Donor is available for search, further typing, and collection/transplant (ODS code: AV).</td></tr><tr><td style=\"white-space:nowrap\">temporarily-unavailable<a name=\"nmdp-donor-status-temporarily-unavailable\"> </a></td><td>Temporarily Unavailable</td><td>Donor is temporarily unavailable, typically post-collection with a future available date (ODS code: TU).</td></tr><tr><td style=\"white-space:nowrap\">active<a name=\"nmdp-donor-status-active\"> </a></td><td>Active</td><td>Donor is currently active on a search — reserved for a specific patient case (ODS code: AC).</td></tr><tr><td style=\"white-space:nowrap\">permanently-unavailable<a name=\"nmdp-donor-status-permanently-unavailable\"> </a></td><td>Permanently Unavailable</td><td>Donor has been permanently removed from the registry. Reasons include: not interested, permanently medically deferred, unable to contact, donor too old, or deceased (ODS code: DE).</td></tr></table></div>"
  ] ;
