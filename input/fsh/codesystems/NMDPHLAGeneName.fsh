CodeSystem: NMDPHLAGeneNameCS
Id: nmdp-hla-gene-name
Title: "NMDP HLA Gene Name Code System"
Description: "HGNC Gene IDs for HLA loci used in donor typing. Subset of HGNC relevant to NMDP operations."
* ^url = "http://terminology.nmdp.org/codesystem/hla-gene-name"
* ^status = #active
* ^caseSensitive = true
* ^content = #complete
* #HGNC:4931 "HLA-A" "Human Leukocyte Antigen class I, locus A"
* #HGNC:4932 "HLA-B" "Human Leukocyte Antigen class I, locus B"
* #HGNC:4933 "HLA-C" "Human Leukocyte Antigen class I, locus C"
* #HGNC:4948 "HLA-DRB1" "Human Leukocyte Antigen class II, DR beta 1"
* #HGNC:4944 "HLA-DQB1" "Human Leukocyte Antigen class II, DQ beta 1"
* #HGNC:4940 "HLA-DPB1" "Human Leukocyte Antigen class II, DP beta 1"
